<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#050713">
  <meta name="description" content="An interactive generative line animation and portfolio introduction for Himakshi Mishra.">
  <title>One Line / Infinite Possibilities — Himakshi Mishra</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: "Fira Code", Consolas, monospace;
      background: #050713;
      color: #c9f7ff;
    }
    * { box-sizing: border-box; }
    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      overflow: hidden;
      background: radial-gradient(ellipse at center, #101a32 0%, #080c1b 48%, #050713 78%);
    }
    canvas { position: fixed; inset: 0; display: block; width: 100%; height: 100%; }
    .title, .subtitle, .controls, .profile-link, .details { position: fixed; z-index: 1; }
    .title {
      top: clamp(20px, 5vw, 40px); left: clamp(20px, 5vw, 48px);
      margin: 0; font-size: clamp(12px, 2vw, 17px); font-weight: 400;
      letter-spacing: 0.22em; text-shadow: 0 0 18px #46cfff88;
    }
    .subtitle {
      top: clamp(48px, 8vw, 72px); left: clamp(20px, 5vw, 48px);
      max-width: min(560px, 70vw); color: #9cb5cc;
      font-size: clamp(10px, 1.25vw, 12px); line-height: 1.8;
      letter-spacing: 0.04em;
    }
    .controls { top: clamp(16px, 4vw, 32px); right: clamp(16px, 4vw, 32px); }
    button {
      padding: 10px 16px; border: 1px solid #34516f; border-radius: 999px;
      background: #0c1528cc; color: #e7fbff; font: inherit; cursor: pointer;
      transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }
    button:hover { transform: translateY(-1px); border-color: #75f3ff; background: #14223a; }
    button:focus-visible, a:focus-visible { outline: 2px solid #75f3ff; outline-offset: 4px; }
    .details {
      left: clamp(20px, 5vw, 48px); bottom: clamp(68px, 10vw, 90px);
      max-width: min(560px, 82vw); color: #b6d1e5; font-size: clamp(10px, 1.2vw, 12px);
      line-height: 1.9; text-shadow: 0 0 12px #050713;
    }
    .details strong { color: #c9f7ff; font-weight: 500; }
    .details a { color: #75f3ff; text-decoration-color: #5bc0be88; text-underline-offset: 4px; }
    .profile-link {
      bottom: clamp(20px, 5vw, 40px); left: 50%; color: #9cb5cc;
      font-size: 12px; text-decoration-color: #5bc0be88; text-underline-offset: 5px;
      transform: translateX(-50%); white-space: nowrap;
    }
    .profile-link:hover { color: #c9f7ff; }
    @media (max-width: 600px) {
      .subtitle { top: 76px; max-width: 82vw; }
      .details { bottom: 76px; }
      .profile-link { font-size: 10px; }
      .controls button { padding: 8px 11px; font-size: 11px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
  <h1 class="title">HIMAKSHI MISHRA / INFINITE POSSIBILITIES</h1>
  <p class="subtitle">Computer Science &amp; Engineering student · Problem solving · AI-powered projects · Creative technology</p>
  <div class="controls">
    <button id="restart" type="button">Draw Again <span aria-hidden="true">↻</span></button>
  </div>
  <canvas id="canvas" role="img" aria-label="A glowing cyan line drawing a complex flower pattern"></canvas>

  <section class="details" aria-label="Portfolio highlights">
    <div><strong>Currently exploring:</strong> AI-powered learning tools and sentiment analysis</div>
    <div><strong>Selected work:</strong> Note Ninja · Inner Vaani · Balance Beam</div>
    <div><strong>Achievements:</strong> 700+ LeetCode problems · 6-Star HackerRank coder</div>
    <div><a href="mailto:mishra.himakshi11@gmail.com">mishra.himakshi11@gmail.com</a></div>
  </section>

  <a class="profile-link" href="https://github.com/Codeisjay" target="_blank" rel="noopener noreferrer">← Visit GitHub profile</a>

  <script>
    const canvas = document.getElementById("canvas");
    const context = canvas.getContext("2d");
    const restartButton = document.getElementById("restart");
    const total = 9000;
    const batchSize = 14;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    let progress = 0;
    let animationFrame = 0;

    function point(index) {
      const t = index / total * Math.PI * 20;
      const scale = Math.min(width, height) * 0.34;
      const radius = scale * (0.55 + 0.32 * Math.cos(7 * t) + 0.13 * Math.sin(13 * t));
      return {
        x: width / 2 + radius * Math.cos(t),
        y: height / 2 + radius * Math.sin(t)
      };
    }

    function drawFrame() {
      const nextProgress = reducedMotion.matches ? total : Math.min(progress + batchSize, total);
      context.beginPath();
      const start = point(progress);
      context.moveTo(start.x, start.y);
      for (let index = progress + 1; index <= nextProgress; index += 1) {
        const position = point(index);
        context.lineTo(position.x, position.y);
      }
      context.strokeStyle = "#75f3ff";
      context.lineWidth = 1.5;
      context.lineCap = "round";
      context.lineJoin = "round";
      context.shadowColor = "#46cfff";
      context.shadowBlur = 12;
      context.stroke();
      context.shadowBlur = 0;
      progress = nextProgress;
      if (progress < total) animationFrame = window.requestAnimationFrame(drawFrame);
    }

    function resizeCanvas() {
      width = window.innerWidth;
      height = window.innerHeight;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      window.cancelAnimationFrame(animationFrame);
      context.clearRect(0, 0, width, height);
      progress = 0;
      if (reducedMotion.matches) drawFrame();
      else animationFrame = window.requestAnimationFrame(drawFrame);
    }

    restartButton.addEventListener("click", resizeCanvas);
    window.addEventListener("resize", resizeCanvas);
    reducedMotion.addEventListener?.("change", resizeCanvas);
    resizeCanvas();
  </script>
</body>
</html>